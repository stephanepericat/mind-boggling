# Clerk — create an application at https://dashboard.clerk.com and disable
# public sign-ups. Invite approved friends and family from the Clerk dashboard.
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NUXT_CLERK_SECRET_KEY=sk_test_replace_me

# Public origin used when generating match invite links.
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Used to sign the short-lived, HTTP-only invite-intent cookie. Generate at
# least 32 random bytes, for example: openssl rand -base64 32
NUXT_INVITE_COOKIE_SECRET=replace_with_a_long_random_value

# Never enable in production. When true, server requests use a local demo user
# so UI development can proceed without a Clerk session. A valid Clerk
# publishable key is still required to initialize the Clerk UI SDK.
NUXT_PUBLIC_DEMO_MODE=false

# Wrangler reads these for scripted Cloudflare deployments. D1 database IDs and
# the external Durable Object script binding are configured in wrangler.jsonc.
CLOUDFLARE_ACCOUNT_ID=replace_me
CLOUDFLARE_API_TOKEN=replace_me
