{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mind-boggling",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mind-boggling",
      "database_id": "9c9054c9-cc4c-482c-b16d-b973020e5b6e",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOMS",
        "class_name": "MatchRoom",
        "script_name": "mind-boggling-match-room"
      }
    ]
  }
}
