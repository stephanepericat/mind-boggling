{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mind-boggling-match-room",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCH_ROOMS",
        "class_name": "MatchRoom"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mind-boggling",
      "database_id": "9c9054c9-cc4c-482c-b16d-b973020e5b6e",
      "migrations_dir": "../../migrations"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoom"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
